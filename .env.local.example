# NexusSim 環境變數範例
# 本地開發：複製此檔為 .env.local 後填入金鑰（.env.local 已被 .gitignore 忽略）
# Netlify 線上部署：請在 Netlify 後台 Site configuration → Environment variables 設定 DEEPSEEK_API_KEY

# DeepSeek API 金鑰（選填；設定後即進入伺服器託管模式，使用者無須填寫任何金鑰）
# 有金鑰 → 四位 NPC 對話、VP 即時回覆與四維度能力評估全數由真實 DeepSeek LLM 驅動（LIVE AI）
# 無金鑰 → 自動降級為離線 mock 引擎（OFFLINE DEMO），功能與流程完全一致
DEEPSEEK_API_KEY=

# 自訂端點與模型（選填）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# API 請求逾時毫秒數（選填；預設 8500ms 以相容 Netlify 免費方案 10 秒限制；Pro 方案可設為 22000）
# DEEPSEEK_TIMEOUT_MS=8500

# 是否允許瀏覽器端透過設定彈窗自行覆寫金鑰（預設關閉，僅於伺服器未設 Key 或顯式設為 true 時開放）
# ALLOW_CLIENT_API_KEY=false
